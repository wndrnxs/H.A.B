rules_version = '2';

// 우리집 가계부 규칙
//
// 한 줄 요약: 로그인한 사람만, 자기가 속한 가계부만 읽고 쓴다.
// 초대 코드를 아는 사람은 "초대가 열려 있는 동안"만 자기 자신을 구성원으로 넣을 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    // 이 사람이 어느 가계부에 속하는지 기억해 두는 곳. 본인만 본다.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      // 구성원이거나, 초대가 열려 있을 때만 읽힌다.
      // 초대를 닫으면 코드를 알아도 아무것도 볼 수 없다.
      allow get: if signedIn()
        && (request.auth.uid in resource.data.memberUids || resource.data.joinOpen == true);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // 구성원은 장부를 자유롭게 고친다
        request.auth.uid in resource.data.memberUids
        // 또는, 초대가 열려 있을 때 '자기 자신 한 명만' 구성원에 덧붙인다.
        // memberUids 말고 다른 것은 건드릴 수 없다.
        || (
          resource.data.joinOpen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      // 거래 내역은 달마다 문서 하나 (tx/2026-09)
      match /tx/{month} {
        allow read, write: if isMemberOf(hid);
      }
    }

    // 그 밖의 모든 경로는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
